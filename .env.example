# Local preview; copy to .env only if your launcher loads it. Never commit real values.
VISA_ENV=development
PORT=8898
# Private path outside web assets; optional locally.
# VISA_DB_PATH=/private/path/visaready.sqlite3
# Public hosted build only:
# VISA_ORIGIN=https://your-approved-domain.example
# VISA_SECRET_KEY=<Fernet key from the server secret manager>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=
# SMTP_USER=
# SMTP_PASSWORD=
# PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MERCHANT_ID=
# PAYPAL_WEBHOOK_ID=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna # Budget candidate; validate model quality before launch
# LEGAL_REVIEW_APPROVED=yes # Only after actual independent review and operator policy approval
