# Copy to /etc/chargeready/production.env, owned by root with mode 0600.
# This file uses systemd EnvironmentFile syntax, not shell commands.
VISA_ENV=production
PORT=8765
VISA_ORIGIN=https://prep.particlesolidlab.com
VISA_DB_PATH=/var/lib/chargeready/chargeready.sqlite3
VISA_SECRET_KEY=REPLACE_WITH_PRIVATE_FERNET_KEY
TRUSTED_PROXY_IPS=127.0.0.1
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Leave unapproved until actual independent review and operator policy completion.
LEGAL_REVIEW_APPROVED=no
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
# Optional: only enable after evaluation and accurate privacy disclosures.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
